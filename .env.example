# Backend
APP_ENV=development
PORT=3001
DATABASE_URL=postgres://novafield:novafield@localhost:5432/novafield?sslmode=disable
SESSION_SECRET=replace-with-at-least-32-random-characters
CORS_ORIGINS=http://localhost:3000
SHUTDOWN_TIMEOUT=15s

# S3-compatible object storage
S3_ENDPOINT=localhost:9000
S3_ACCESS_KEY=replace-me
S3_SECRET_KEY=replace-me
S3_BUCKET=novafield
S3_PUBLIC_BASE_URL=http://localhost:9000/novafield
S3_USE_TLS=false

# Optional Spotify integration
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://localhost:3001/api/v1/spotify/callback

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1
NEXT_PUBLIC_WS_URL=ws://localhost:3001
